{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Data Source=ai-content-platform.db"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  // Provider selection: "Auto" | "Mock" | "Anthropic" | "OpenAI".
  // "Auto" picks the first provider with an API key configured and falls back to Mock.
  // Never commit keys: use `dotnet user-secrets`, or env vars such as
  // ANTHROPIC_API_KEY / OPENAI_API_KEY (or Ai__Anthropic__ApiKey / Ai__OpenAI__ApiKey).
  "Ai": {
    "TextProvider": "Auto",
    "ImageProvider": "Auto",
    "Anthropic": {
      "ApiKey": "",
      "Model": "claude-sonnet-5-5",
      "MaxTokens": 2048,
      "BaseUrl": "https://api.anthropic.com/"
    },
    "OpenAI": {
      "ApiKey": "",
      "Model": "gpt-4.1-mini",
      "ImageModel": "gpt-image-1",
      "BaseUrl": "https://api.openai.com/"
    }
  }
}
