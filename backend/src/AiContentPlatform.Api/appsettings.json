{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Data Source=ai-content-platform.db"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  // Provider selection: "Auto" | "Mock" | "Anthropic" | "OpenAI".
  // "Auto" picks the first provider with an API key configured and falls back to Mock.
  // Never commit keys: use `dotnet user-secrets`, or env vars such as
  // ANTHROPIC_API_KEY / OPENAI_API_KEY (or Ai__Anthropic__ApiKey / Ai__OpenAI__ApiKey).
  "Ai": {
    "TextProvider": "Auto",
    "ImageProvider": "Auto",
    "Anthropic": {
      "ApiKey": "",
      "Model": "claude-sonnet-5-5",
      "MaxTokens": 2048,
      "BaseUrl": "https://api.anthropic.com/",
      "ServerSideFallback": true
    },
    // USD per million tokens, used for the cost estimates on the Usage page. Anthropic first-party
    // API rates as of 2026-09 (incl. the models server-side fallback can switch to); check
    // https://www.anthropic.com/pricing and add other models you use.
    // Models without a price are tracked with tokens only ("not priced").
    "Pricing": {
      "claude-opus-5-5": { "InputPerMTok": 4.0, "OutputPerMTok": 20.0 },
      "claude-sonnet-5-5": { "InputPerMTok": 2.0, "OutputPerMTok": 10.0 },
      "claude-sonnet-5": { "InputPerMTok": 2.0, "OutputPerMTok": 10.0 },
      "claude-opus-5": { "InputPerMTok": 5.0, "OutputPerMTok": 25.0 },
      "claude-opus-4-8": { "InputPerMTok": 5.0, "OutputPerMTok": 25.0 },
      "claude-haiku-4-5": { "InputPerMTok": 1.0, "OutputPerMTok": 5.0 },
      "claude-fable-5-1": { "InputPerMTok": 10.0, "OutputPerMTok": 50.0 }
    },
    "OpenAI": {
      "ApiKey": "",
      "Model": "gpt-4.1-mini",
      "ImageModel": "gpt-image-1",
      "BaseUrl": "https://api.openai.com/"
    }
  }
}
