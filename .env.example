# Copy to .env (git-ignored) and adjust. Used by docker-compose.yml.

# Change this for anything beyond local testing.
POSTGRES_PASSWORD=change-me

# Optional: real AI output instead of the built-in mock.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: Google / Microsoft sign-in (redirect URI: <your URL>/signin-google, /signin-microsoft).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Host port, and whether an HTTPS reverse proxy sits in front.
APP_PORT=8080
BEHIND_PROXY=false
